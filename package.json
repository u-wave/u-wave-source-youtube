{
  "name": "u-wave-source-youtube",
  "description": "YouTube media source for üWave.",
  "version": "2.1.0",
  "author": "Sooyou",
  "contributors": [
    "Renée Kooi <renee@kooi.me>"
  ],
  "type": "module",
  "dependencies": {
    "get-artist-title": "^1.2.0",
    "get-youtube-chapters": "^2.0.0",
    "http-errors": "^2.0.0",
    "parse-iso-duration": "^1.1.0"
  },
  "devDependencies": {
    "@types/http-errors": "^2.0.0",
    "@types/qs": "^6.9.4",
    "dprint": "^0.55.1",
    "nock": "^14.0.0",
    "oxlint": "^1.1.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">= 20"
  },
  "main": "./dist/index.mjs",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "keywords": [
    "u-wave-source",
    "youtube"
  ],
  "license": "MIT",
  "repository": "u-wave/u-wave-source-youtube",
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts",
    "prepare": "npm run build",
    "lint": "oxlint src && dprint check",
    "tests-only": "node test/test.js",
    "test": "npm run build && npm run types && npm run tests-only && npm run lint",
    "types": "tsc -p . --noEmit"
  },
  "typings": "./dist/index.d.ts"
}
